{
  "name": "oichat",
  "version": "0.1.0",
  "private": true,
  "description": "Oi Chat — assistente de voz que abre o ChatGPT oficial com a palavra de ativação \"Oi, Chat\"",
  "author": "Oi Chat",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "models": "node scripts/download-models.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "node scripts/download-models.mjs",
    "prebuild": "node scripts/download-models.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "electron:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "electron:dev": "npm run electron:main && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "electron:start": "npm run build && npm run electron:main && electron .",
    "build:win": "npm run build && npm run electron:main && electron-builder --win",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run cap:sync && cd android && .\\gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vosk-browser": "^0.0.8",
    "wait-on": "^9.5.1",
    "zustand": "^5.1.0"
  }
}
